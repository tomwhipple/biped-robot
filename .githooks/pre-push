#!/bin/sh
# Pre-push gate: runs the CI gate-set locally before every push,
# so nothing CI caught is lost when .github/workflows/ci.yml fires no jobs.
#
# The hook diffs the pushed refs and runs only the gates the change can
# affect. Inert files -- anything under docs/, *.md, images, PDFs, HTML
# reports, .github/ and .claude/ -- are read by no gate, so they trigger
# none: a push of only those runs nothing.
# The C/C++ gates ([1], [4]-[9]) run only when the push changes C/C++: a
# source or header anywhere, anything else under firmware/, or the root
# .clang-tidy (Tom, 2026-10-06: "the C++ checks should only fire when there
# are C++ changes"). The Python gates [2] and [3] run when the push changes
# any other file (Tom, 2026-10-08: "updating an .md file shouldn't trigger
# python/sil tests"); the suites read sim/, cad/, tools/, link/, firmware/
# and experiments/, so any non-inert file triggers them. Without C/C++
# changes [1] just builds the SIL suite's library. PREPUSH_ALL=1 forces
# every gate, and so does a push the hook cannot diff (run by hand, a remote
# tip it does not have, no merge base with origin/main).
#
# Per Tom (2026-09-16): "disable all CI on this project and make it run as a
# pre-push hook instead." ALL gates the old CI ran execute here:
#   [1/9] host check      make -C firmware/host check  (hard; C/C++ pushes, else make sil
#                         when [3/9] runs)
#   [2/9] link-tests      python3 -m pytest tests/ -q  (hard; non-inert pushes)
#   [3/9] sil-suite       python3 -m pytest sim/sil -q (hard; non-inert pushes; the tests
#                         that need the deployed run's gitignored artifacts
#                         SKIP with a reason on a machine without them)
#   [4/9] cmake-ctest     cmake configure/build/ctest  (C/C++ pushes; hard when cmake installed, skip with note otherwise)
#   [5/9] clang-tidy      run-clang-tidy -p build -quiet  (toolchain-guarded)
#   [6/9] clang-tidy-gui  firmware/host/clang-tidy-gui.sh (toolchain-guarded; runs make deps)
#   [7/9] cppcheck        firmware/host/cppcheck.sh    (toolchain-guarded)
#   [8-9/9] esp32-build   idf.py build (the project in firmware/; firmware/main is
#                         a component) — detection: idf.py on
#                         PATH, else source $IDF_PATH/export.sh, else hardcoded
#                         $HOME/.espressif/frameworks/esp-idf-v5.4; SKIP_ESP32=1
#                         overrides a missing toolchain.
# Static-analysis gates fail on findings (same pass/fail semantics as the old
# CI jobs: run-clang-tidy honours WarningsAsErrors from .clang-tidy;
# cppcheck.sh fails on ANY finding).
#
# Enable once per clone:
#   git config core.hooksPath .githooks

set -u

ROOT="$(git rev-parse --show-toplevel)"

# Prefer the project venv when present: the sim suites need mujoco/jax,
# which the bare interpreter does not carry (issue #118). Worktree clones
# symlink .venv to the main clone's venv, so a bare clone falls back to
# a sibling checkout's venv.
PY="python3"
if [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
else
  for guess in "$ROOT/../robot/.venv/bin/python" \
               "$HOME/code/robot/.venv/bin/python"; do
    if [ -x "$guess" ]; then
      PY="$guess"
      break
    fi
  done
fi

rc=0

# macOS + Linux portable helpers.
ncpu() { nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1; }
mkbuild() { mktemp -d 2>/dev/null || mktemp -d '/tmp/biped-robot-ci-build.XXXXXX'; }

# --- which gates this push needs ----------------------------------------------
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.
zero=0000000000000000000000000000000000000000
# Files no gate reads (checked 2026-10-08: tests/, sim/sil, the modules they
# import and the firmware build name these only in comments, or write them).
is_inert() {
  case "$1" in
    docs/*|*.md|*.png|*.jpg|*.jpeg|*.gif|*.svg|*.webp|*.pdf|*.html|.github/*|.claude/*) return 0 ;;
  esac
  return 1
}
is_cpp() {
  case "$1" in
    *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx|*.ino|firmware/*|.clang-tidy) return 0 ;;
  esac
  return 1
}
# Set when the hook cannot tell what changed: every gate runs.
force=""
cpp_files=""
py_files=""
if [ "${PREPUSH_ALL:-0}" != "0" ]; then
  force="PREPUSH_ALL=$PREPUSH_ALL"
elif [ -t 0 ]; then
  force="run by hand, no pushed refs to diff"
else
  nlines=0
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] || continue
    nlines=$((nlines + 1))
    [ "$lsha" != "$zero" ] || continue   # a branch deletion pushes no content
    if [ "$rsha" = "$zero" ]; then
      base="$(git merge-base "$lsha" origin/main 2>/dev/null)" || base=""
    elif git cat-file -e "$rsha^{commit}" 2>/dev/null; then
      base="$rsha"
    else
      base=""
    fi
    if [ -z "$base" ]; then
      force="cannot diff $lsha against the remote"
      continue
    fi
    if ! names="$(git -c core.quotePath=false diff --no-renames --name-only "$base" "$lsha" 2>/dev/null)"; then
      force="cannot diff $lsha against the remote"
      continue
    fi
    live="$(printf '%s\n' "$names" |
      while IFS= read -r f; do
        if [ -n "$f" ] && ! is_inert "$f"; then printf '%s\n' "$f"; fi
      done)"
    [ -n "$live" ] || continue
    py_files="$py_files$live
"
    hits="$(printf '%s\n' "$live" |
      while IFS= read -r f; do if is_cpp "$f"; then printf '%s\n' "$f"; fi; done)"
    if [ -n "$hits" ]; then
      cpp_files="$cpp_files$hits
"
    fi
  done
  if [ "$nlines" -eq 0 ]; then
    force="no pushed refs on stdin"
  fi
fi
# "<n> <what> file(s) changed, e.g. a b c" for a newline-separated list.
changed() {
  list="$(printf '%s\n' "$1" | sed '/^$/d' | sort -u)"
  printf '%s %s file(s) changed, e.g. %s' \
    "$(printf '%s\n' "$list" | wc -l | tr -d ' ')" "$2" \
    "$(printf '%s\n' "$list" | head -3 | tr '\n' ' ')"
}
if [ -n "$force" ]; then
  cpp="$force"
  py="$force"
else
  cpp=""
  py=""
  if [ -n "$cpp_files" ]; then cpp="$(changed "$cpp_files" C/C++)"; fi
  if [ -n "$py_files" ]; then py="$(changed "$py_files" non-doc)"; fi
fi
if [ -n "$cpp" ]; then
  echo "C/C++ gates: ON ($cpp)"
else
  echo "C/C++ gates: SKIP -- this push changes no C/C++, firmware/ or .clang-tidy file (PREPUSH_ALL=1 forces them)"
fi
if [ -n "$py" ]; then
  echo "Python gates: ON ($py)"
else
  echo "Python gates: SKIP -- this push changes only docs/, *.md, images, PDFs, HTML, .github/ or .claude/ (PREPUSH_ALL=1 forces them)"
fi

echo "== pre-push: making sure everything compiles, linked, and tested =="
echo "(same set CI used to check — now local instead of GitHub Actions)"

# --- [1/9] host gate (the mjpeg.cpp lesson) + tui (console client) ----------
echo "" >&2
if [ -n "$cpp" ]; then
  echo "== [host-tests + console/tui] make -C firmware/host check =="
  if ! make -C "$ROOT/firmware/host" check; then
    echo "FAIL: host/tests/gui compile or test failed" >&2
    rc=1
  fi
elif [ -n "$py" ]; then
  # [3/9] still needs libctrl_sil, which the host check would have built.
  echo "== [sil-lib] make -C firmware/host sil (C/C++ gates skipped) =="
  if ! make -C "$ROOT/firmware/host" sil; then
    echo "FAIL: libctrl_sil build failed" >&2
    rc=1
  fi
fi

if [ -z "$py" ]; then
  echo "SKIP: host-check, sil-lib, link-tests, sil-suite (only docs, images and the like changed)" >&2
else

  # --- [2/9] link-test suite (protocol, sources, e2e simulation tests) -------
  echo "" >&2
  echo "== [link-tests] pytest over link/test suite =="
  if ! "$PY" -m pytest "$ROOT/tests/" -q; then
    echo "FAIL: link-test suite failed" >&2
    rc=1
  fi

  # --- [3/9] SIL suite (the firmware's control code against the CPU plant) ---
  # Runs after [1/9], which built firmware/host/build/libctrl_sil. Tests that
  # need the deployed run's gitignored artifacts (sim/runs/<run>/, the .silw)
  # skip with a reason where they are absent; the rest always run (issue #89).
  echo "" >&2
  echo "== [sil-suite] pytest sim/sil =="
  if ! "$PY" -m pytest "$ROOT/sim/sil" -q; then
    echo "FAIL: SIL suite failed" >&2
    rc=1
  fi
fi

# --- [4/9]..[8-9/9]: the C/C++ toolchain gates, on C/C++ pushes only -----------
if [ -z "$cpp" ]; then
  echo "" >&2
  echo "SKIP: cmake-ctest, clang-tidy, clang-tidy-gui, cppcheck, esp32-build (no C/C++ changes)" >&2
else

  # --- [4/9] cmake + ctest (both build files must agree) -----------------------
  echo "" >&2
  echo "== [cmake-ctest] verifying cmake builds and tests pass =="
  build_dir=""

  if ! command -v cmake >/dev/null 2>&1; then
    echo "SKIP: cmake not installed — run 'brew install cmake' (macOS) or 'apt-get install cmake'" >&2
  else
    build_dir="$(mkbuild)"
    if ! cmake -S "$ROOT/firmware/host" -B "$build_dir" \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON; then
      echo "FAIL: CMake configure failed (see above)" >&2
      rc=1
    elif ! cmake --build "$build_dir" -j"$(ncpu)"; then
      echo "FAIL: cmake build phase failed (see above)" >&2
      rc=1
    elif ! ctest --test-dir "$build_dir" --output-on-failure; then
      echo "FAIL: ctest failed (see output above)" >&2
      rc=1
    fi
  fi

  # --- [5/9] clang-tidy over host firmware (bugprone/readability classes) ------
  echo "" >&2
  echo "== [clang-tidy] static analysis over host firmware =="
  if ! command -v run-clang-tidy >/dev/null 2>&1; then
    echo "SKIP: clang-tidy not installed — 'apt-get install clang-tidy' / 'brew install llvm'" >&2
  elif [ -z "$build_dir" ] || [ ! -f "$build_dir/compile_commands.json" ]; then
    # No configured build from [4/9] (cmake absent or configure failed — already
    # counted there if it failed).
    echo "SKIP: no compile_commands.json (cmake gate skipped/failed above)" >&2
  elif ! run-clang-tidy -p "$build_dir" -quiet; then
    echo "FAIL: clang-tidy findings (WarningsAsErrors per .clang-tidy)" >&2
    rc=1
  fi

  # --- [6/9] clang-tidy over GUI sources ----------------------------------------
  echo "" >&2
  echo "== [clang-tidy-gui] static analysis over GUI/console sources =="
  if ! command -v clang-tidy >/dev/null 2>&1; then
    echo "SKIP: clang-tidy not installed" >&2
  else
    # clang-tidy-gui.sh needs deps fetched and a compile_commands.json under
    # firmware/host/build (separate from the [4/9] scratch dir, as in old CI).
    gui_build="$ROOT/firmware/host/build"
    gui_created=""
    if [ ! -f "$gui_build/compile_commands.json" ]; then
      if command -v cmake >/dev/null 2>&1; then
        if cmake -S "$ROOT/firmware/host" -B "$gui_build" \
            -DCMAKE_EXPORT_COMPILE_COMMANDS=ON >/dev/null 2>&1; then
          gui_created=1
        else
          echo "SKIP: gui compile_commands.json configure failed" >&2
        fi
      else
        echo "SKIP: cmake not installed (needed for gui compile_commands.json)" >&2
      fi
    fi
    if [ -f "$gui_build/compile_commands.json" ]; then
      if ! make -C "$ROOT/firmware/host" deps; then
        echo "FAIL: make deps (pinned imgui/stb fetch) failed" >&2
        rc=1
      elif ! "$ROOT/firmware/host/clang-tidy-gui.sh"; then
        echo "FAIL: clang-tidy-gui findings" >&2
        rc=1
      fi
    fi
    if [ -n "$gui_created" ]; then
      rm -rf "$gui_build"
    fi
  fi

  # --- [7/9] cppcheck (whole-program, fails on ANY finding) ----------------------
  echo "" >&2
  echo "== [cppcheck] static analysis over firmware + link =="
  if ! command -v cppcheck >/dev/null 2>&1; then
    echo "SKIP: cppcheck not installed — 'apt-get install cppcheck' / 'brew install cppcheck'" >&2
  elif ! "$ROOT/firmware/host/cppcheck.sh"; then
    echo "FAIL: cppcheck findings (wrapper fails on any finding)" >&2
    rc=1
  fi

  # Scratch cmake build cleanup (kept across the tidy gates on purpose: [5/9]
  # reuses its compile_commands.json).
  if [ -n "$build_dir" ] && [ -d "$build_dir" ]; then
    rm -rf "$build_dir"
  fi

  # --- [8-9/9] esp32 firmware build (idf.py link step) ---------------------------
  echo "" >&2
  echo "== [esp32-build] verifying ESP-IDF builds the firmware project (firmware/) =="

  esp_build() {
    ( cd "$ROOT/firmware" && idf.py fullclean >/dev/null 2>&1 && idf.py build )
  }

  if [ "${SKIP_ESP32:-0}" != "0" ]; then
    echo "SKIP: SKIP_ESP32=$SKIP_ESP32 in env" >&2
  elif command -v idf.py >/dev/null 2>&1; then
    # Toolchain already on PATH (real ESP-IDF installs put idf.py's DIR on PATH;
    # export.sh does this).
    if ! esp_build; then
      echo "FAIL: esp32 firmware build failed (see above)" >&2
      rc=1
    fi
  else
    IDF_HOME="${IDF_PATH:-$HOME/.espressif/frameworks/esp-idf-v5.4}"
    if [ -f "$IDF_HOME/export.sh" ]; then
      if ! ( . "$IDF_HOME/export.sh" >/dev/null 2>&1 && esp_build ); then
        echo "FAIL: esp32 firmware build failed (see above)" >&2
        rc=1
      fi
    else
      echo "WARN: no ESP-IDF detected (no idf.py on PATH, no export.sh at ${IDF_HOME})." >&2
      echo "      Install ESP-IDF v5.4, or set IDF_PATH to its location, or SKIP_ESP32=1." >&2
      if [ "${SKIP_ESP32:-0}" = "0" ]; then
        rc=1
      fi
    fi
  fi
fi

if [ "$rc" -eq 0 ]; then
  echo "" >&2
  if [ -z "$py" ]; then
    echo "No gate applies to this push. Safe to push."
  else
    echo "All gates passed. Safe to push."
  fi
  exit 0
else
  echo "" >&2
  echo "Pre-push gate FAILED. Push blocked until fix is pushed." >&2
  echo "Escape hatch (if you know what you're doing): git push --no-verify" >&2
  echo "" >&2
  exit 1
fi
