#!/bin/sh
# Pre-push gate: runs the CI gate-set locally before every push,
# so nothing CI caught is lost when .github/workflows/ci.yml fires no jobs.
#
# The hook diffs the pushed refs and runs only the gates the change can
# affect. Inert files -- anything under docs/, *.md, images, PDFs, HTML
# reports, .github/ and .claude/ -- are read by no gate, so they trigger
# none: a push of only those runs nothing.
# The C/C++ gates ([1], [4]-[9]) run only when the push changes C/C++: a
# source or header anywhere, anything else under firmware/, or the root
# .clang-tidy (Tom, 2026-10-06: "the C++ checks should only fire when there
# are C++ changes"). The Python gates [2] and [3] run when the push changes
# any other file (Tom, 2026-10-08: "updating an .md file shouldn't trigger
# python/sil tests"); the suites read sim/, cad/, tools/, link/, firmware/
# and experiments/, so any non-inert file triggers them. Without C/C++
# changes [1] just builds the SIL suite's library. PREPUSH_ALL=1 forces
# every gate, and so does a push the hook cannot diff (run by hand, a remote
# tip it does not have, no merge base with origin/main).
#
# Per Tom (2026-09-16): "disable all CI on this project and make it run as a
# pre-push hook instead." ALL gates the old CI ran execute here, each as a
# make target, so `make <target>` runs a gate the same way by hand:
#   [1/9] host check      make host       (hard; C/C++ pushes, else make sil-lib
#                         when [3/9] runs)
#   [2/9] link-tests      make pytest     (hard; non-inert pushes)
#   [3/9] sil-suite       make sil-suite  (hard; non-inert pushes; the tests
#                         that need the deployed run's gitignored artifacts
#                         SKIP with a reason on a machine without them)
#   [4/9] cmake-ctest     make cmake-check (C/C++ pushes; SKIP without cmake)
#   [5/9] clang-tidy      make tidy        (SKIP without clang-tidy)
#   [6/9] clang-tidy-gui  make tidy-gui    (SKIP without clang-tidy; runs make deps)
#   [7/9] cppcheck        make cppcheck    (SKIP without cppcheck)
#   [8-9/9] esp32-build   make firmware, then make firmware-powerlite (the
#                         build option off and on, so neither image can rot)
#                         (idf.py on PATH, else $IDF_PATH/export.sh,
#                         else ~/esp/esp-idf or ~/.espressif/frameworks/esp-idf-v5.4;
#                         no ESP-IDF fails the push unless SKIP_ESP32=1)
# Static-analysis gates fail on findings (same pass/fail semantics as the old
# CI jobs: run-clang-tidy honours WarningsAsErrors from .clang-tidy;
# cppcheck.sh fails on ANY finding).
#
# The gates run concurrently where they share nothing (#329): [1] host starts
# with [4]+[5] (cmake-check, then tidy: both use build/host-cmake), [7] and
# [8-9] (firmware, then firmware-powerlite: both use firmware/sdkconfig); [2]
# and [3] start when [1] is done (they read what it built in
# firmware/host/build) and run side by side; [6] starts when [2] and [3] are
# done (it may delete firmware/host/build). [2] runs pytest-xdist workers
# (`make pytest`: PYTEST_WORKERS, default 8; 0 = one process). Each gate keeps
# its own log, <git dir>/prepush-logs/<stamp>-<pid>/<target>.log, next to the
# combined <stamp>-<pid>.log; a failing gate prints "FAIL: <gate>" with its
# log path. Every gate runs, whatever the others did, and the same pass/fail
# and SKIP rules apply. PREPUSH_SERIAL=1 runs the gates one at a time.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

set -u

ROOT="$(git rev-parse --show-toplevel)"

# Prefer the project venv when present: the sim suites need mujoco/jax,
# which the bare interpreter does not carry (issue #118). Worktree clones
# symlink .venv to the main clone's venv, so a bare clone falls back to
# a sibling checkout's venv.
PY="python3"
if [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
else
  for guess in "$ROOT/../robot/.venv/bin/python" \
               "$HOME/code/robot/.venv/bin/python"; do
    if [ -x "$guess" ]; then
      PY="$guess"
      break
    fi
  done
fi

rc=0

# --- which gates this push needs ----------------------------------------------
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.
zero=0000000000000000000000000000000000000000
# Files no gate reads (checked 2026-10-08: tests/, sim/sil, the modules they
# import and the firmware build name these only in comments, or write them).
is_inert() {
  case "$1" in
    docs/*|*.md|*.png|*.jpg|*.jpeg|*.gif|*.svg|*.webp|*.pdf|*.html|.github/*|.claude/*) return 0 ;;
  esac
  return 1
}
is_cpp() {
  case "$1" in
    *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx|*.ino|firmware/*|.clang-tidy) return 0 ;;
  esac
  return 1
}
# Set when the hook cannot tell what changed: every gate runs.
force=""
cpp_files=""
py_files=""
if [ "${PREPUSH_ALL:-0}" != "0" ]; then
  force="PREPUSH_ALL=$PREPUSH_ALL"
elif [ -t 0 ]; then
  force="run by hand, no pushed refs to diff"
else
  nlines=0
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] || continue
    nlines=$((nlines + 1))
    [ "$lsha" != "$zero" ] || continue   # a branch deletion pushes no content
    if [ "$rsha" = "$zero" ]; then
      base="$(git merge-base "$lsha" origin/main 2>/dev/null)" || base=""
    elif git cat-file -e "$rsha^{commit}" 2>/dev/null; then
      base="$rsha"
    else
      base=""
    fi
    if [ -z "$base" ]; then
      force="cannot diff $lsha against the remote"
      continue
    fi
    if ! names="$(git -c core.quotePath=false diff --no-renames --name-only "$base" "$lsha" 2>/dev/null)"; then
      force="cannot diff $lsha against the remote"
      continue
    fi
    live="$(printf '%s\n' "$names" |
      while IFS= read -r f; do
        if [ -n "$f" ] && ! is_inert "$f"; then printf '%s\n' "$f"; fi
      done)"
    [ -n "$live" ] || continue
    py_files="$py_files$live
"
    hits="$(printf '%s\n' "$live" |
      while IFS= read -r f; do if is_cpp "$f"; then printf '%s\n' "$f"; fi; done)"
    if [ -n "$hits" ]; then
      cpp_files="$cpp_files$hits
"
    fi
  done
  if [ "$nlines" -eq 0 ]; then
    force="no pushed refs on stdin"
  fi
fi
# "<n> <what> file(s) changed, e.g. a b c" for a newline-separated list.
changed() {
  list="$(printf '%s\n' "$1" | sed '/^$/d' | sort -u)"
  printf '%s %s file(s) changed, e.g. %s' \
    "$(printf '%s\n' "$list" | wc -l | tr -d ' ')" "$2" \
    "$(printf '%s\n' "$list" | head -3 | tr '\n' ' ')"
}
if [ -n "$force" ]; then
  cpp="$force"
  py="$force"
else
  cpp=""
  py=""
  if [ -n "$cpp_files" ]; then cpp="$(changed "$cpp_files" C/C++)"; fi
  if [ -n "$py_files" ]; then py="$(changed "$py_files" non-doc)"; fi
fi
if [ -n "$cpp" ]; then
  echo "C/C++ gates: ON ($cpp)"
else
  echo "C/C++ gates: SKIP -- this push changes no C/C++, firmware/ or .clang-tidy file (PREPUSH_ALL=1 forces them)"
fi
if [ -n "$py" ]; then
  echo "Python gates: ON ($py)"
else
  echo "Python gates: SKIP -- this push changes only docs/, *.md, images, PDFs, HTML, .github/ or .claude/ (PREPUSH_ALL=1 forces them)"
fi

echo "== pre-push: making sure everything compiles, links and passes =="

# Each gate is a make target (`make help`, Tests and Firmware), so a gate runs
# the same here as by hand. A target whose tool is missing prints SKIP and passes.
# Every gate's output is kept: one log per gate in <git dir>/prepush-logs/<stamp>-<pid>/
# plus the combined log <stamp>-<pid>.log (gate outputs in the order the gates
# finish), the newest PREPUSH_KEEP (default 10) pushes kept, and the path
# printed on failure -- a flake seen once in the gate (#148) was gone with the
# terminal scrollback before anyone could read it.
GITC="$(git rev-parse --git-common-dir 2>/dev/null)" || GITC=""
LOGDIR="" LOG=/dev/null GDIR=""
if [ -n "$GITC" ]; then
  LOGDIR="$(cd "$GITC" && pwd)/prepush-logs"
  if mkdir -p "$LOGDIR" 2>/dev/null; then
    stem="$LOGDIR/$(date +%Y%m%d-%H%M%S)-$$"
    LOG="$stem.log"
    ls -1t "$LOGDIR"/*.log 2>/dev/null | tail -n +"$(( ${PREPUSH_KEEP:-10} + 1 ))" | while read -r old; do
      rm -rf "$old" "${old%.log}"
    done
    GDIR="$stem"
    mkdir -p "$GDIR" 2>/dev/null || GDIR=""
  fi
fi
CLEAN_GDIR=""
if [ -z "$GDIR" ]; then
  GDIR="$(mktemp -d)"
  CLEAN_GDIR=1
fi
trap '[ -z "$CLEAN_GDIR" ] || rm -rf "$GDIR"' EXIT
trap 'kill $(jobs -p) 2>/dev/null; exit 130' INT TERM

# --- running the gates ------------------------------------------------------------
# Independent gates run side by side (#329); PREPUSH_SERIAL=1 runs them one at
# a time instead. A gate's output goes to its own log and is replayed, whole,
# when the gate finishes, so concurrent gates never interleave. What shares a
# build tree stays ordered:
#   [1] host builds firmware/host/build, which [2]'s console tests and [3]'s
#       SIL library read, so [2] and [3] start once [1] is done;
#   [6] tidy-gui configures firmware/host/build itself and may delete it again,
#       so it starts once [2] and [3] are done;
#   [4] and [5] share build/host-cmake, so [5] follows [4].
# [7] cppcheck reads sources only; [8-9] runs firmware, then firmware-powerlite
# (build/firmware*, one sdkconfig). They share nothing with the rest and start
# with [1]. Every gate runs whatever another gate did, as before.
STARTED=""   # tags of the gates launched, in launch order
REPORTED=""  # tags whose output has been replayed

# run_one "<label>" <make target>: runs the gate in the foreground, leaving
# <tag>.log, <tag>.secs and (last) <tag>.rc in $GDIR.
run_one() {
  _tag="$2"
  _t0="$(date +%s)"
  make -C "$ROOT" PY="$PY" "$2" > "$GDIR/$_tag.log" 2>&1
  _rc=$?
  echo "$(( $(date +%s) - _t0 ))" > "$GDIR/$_tag.secs"
  echo "$_rc" > "$GDIR/$_tag.rc.tmp"
  mv "$GDIR/$_tag.rc.tmp" "$GDIR/$_tag.rc"
}
# launch "<label>" <target> [ "<label>" <target> ... ]: a chain of gates, one
# after another, in the background (the foreground with PREPUSH_SERIAL=1).
launch() {
  _chain=""
  _args=""
  while [ "$#" -ge 2 ]; do
    STARTED="$STARTED $2"
    echo "$1" > "$GDIR/$2.label"
    _chain="$_chain run_one '$1' $2;"
    shift 2
  done
  if [ "${PREPUSH_SERIAL:-0}" != "0" ]; then
    eval "$_chain"
  else
    eval "( $_chain ) &"
  fi
}
# report_done: replay the output of every gate that has finished since the last call.
report_done() {
  for _tag in $STARTED; do
    case " $REPORTED " in *" $_tag "*) continue ;; esac
    [ -f "$GDIR/$_tag.rc" ] || continue
    REPORTED="$REPORTED $_tag"
    _label="$(cat "$GDIR/$_tag.label")"
    _rc="$(cat "$GDIR/$_tag.rc")"
    echo "" >&2
    echo "== [$_label] make $_tag ($(cat "$GDIR/$_tag.secs") s) ==" | tee -a "$LOG"
    tee -a "$LOG" < "$GDIR/$_tag.log"
    if [ "$_rc" != 0 ]; then
      echo "FAIL: $_label (make $_tag) -- its log: $GDIR/$_tag.log" >&2
      rc=1
    fi
  done
}
# await <tag>...: wait until those gates have finished, replaying output as it
# arrives, and a heartbeat every 30 s (an idle SSH session to GitHub is dropped).
await() {
  _beat=0
  while :; do
    report_done
    _wait=""
    for _tag in "$@"; do
      [ -f "$GDIR/$_tag.rc" ] || _wait="$_wait $_tag"
    done
    [ -n "$_wait" ] || return 0
    sleep 1
    _beat=$((_beat + 1))
    if [ "$_beat" -ge 30 ]; then
      _beat=0
      echo "... still running:$_wait" >&2
    fi
  done
}

# [1/9] the host checks (the mjpeg.cpp lesson) and the consoles; without C/C++
# changes only the SIL library that [3/9] loads.
if [ -n "$cpp" ]; then
  launch "1/9 host" host
elif [ -n "$py" ]; then
  launch "1/9 sil-lib" sil-lib
fi

if [ -n "$cpp" ]; then
  launch "4/9 cmake-ctest" cmake-check "5/9 clang-tidy" tidy
  launch "7/9 cppcheck" cppcheck
  if [ "${SKIP_ESP32:-0}" != "0" ]; then
    echo "SKIP: esp32-build (SKIP_ESP32=$SKIP_ESP32 in env)" >&2
  else
    launch "8-9/9 esp32-build" firmware "8-9/9 esp32-build power lite" firmware-powerlite
  fi
else
  echo "" >&2
  echo "SKIP: cmake-ctest, clang-tidy, clang-tidy-gui, cppcheck, esp32-build (no C/C++ changes)" >&2
fi

if [ -n "$py" ]; then
  if [ -n "$cpp" ]; then await host; else await sil-lib; fi
  # Tests that need the deployed run's gitignored artifacts skip with a reason
  # where they are absent (issue #89). make pytest runs xdist workers
  # (PYTEST_WORKERS, default 8; 0 = one process).
  launch "2/9 link-tests" pytest
  launch "3/9 sil-suite" sil-suite
  await pytest sil-suite
else
  echo "SKIP: host-check, sil-lib, link-tests, sil-suite (only docs, images and the like changed)" >&2
fi

if [ -n "$cpp" ]; then
  launch "6/9 clang-tidy-gui" tidy-gui
fi
await $STARTED
wait

if [ -n "$STARTED" ]; then
  echo "" >&2
  echo "== gate times (s) ==" | tee -a "$LOG"
  for _tag in $STARTED; do
    printf '%-12s %5s  rc=%s\n' "$_tag" "$(cat "$GDIR/$_tag.secs")" "$(cat "$GDIR/$_tag.rc")" | tee -a "$LOG"
  done
fi

if [ "$rc" -eq 0 ]; then
  echo "" >&2
  if [ -z "$py" ]; then
    echo "No gate applies to this push. Safe to push."
  else
    echo "All gates passed. Safe to push."
  fi
  exit 0
else
  echo "" >&2
  echo "Pre-push gate FAILED. Push blocked until fix is pushed." >&2
  [ "$LOG" = /dev/null ] || echo "Full gate output: $LOG" >&2
  echo "Escape hatch (if you know what you're doing): git push --no-verify" >&2
  echo "" >&2
  exit 1
fi
