#!/bin/sh
# Pre-push gate: runs the full CI gate-set locally before every push, 
# so nothing CI caught is lost when .github/workflows/ci.yml fires no jobs.
#
# Per Tom (2026-09-16): "disable all CI on this project and make it run as a 
# pre-push hook instead." The four heavy gates (cmake-ctest, clang-tidy, cppcheck,
# esp32-build) now run here too — toolchain must be installed locally.
#
# Enables once per clone:
#   git config core.hooksPath .githooks

set -u

ROOT="$(git rev-parse --show-toplevel)"

rc=0

echo "== pre-push: making sure everything compiles, linked, and tested =="
echo "(same set CI used to check — now local instead of GitHub Actions)"

# --- [1/4] host gate (the mjpeg.cpp lesson) + tui (console client) ----------
echo "" >&2
echo "== [host-tests + console/tui] make -C firmware/host check =="
if ! make -C "$ROOT/firmware/host" check; then
  echo "FAIL: host/tests/gui compile or test failed" >&2
  rc=1
fi

# --- [2/4] link-test suite (protocol, sources, e2e simulation tests) -------
echo "" >&2  
echo "== [link-tests] pytest over link/test suite =="
if ! python3 -m pytest "$ROOT/tests/" -q; then
  echo "FAIL: link-test suite failed" >&2
  rc=1
fi

# --- [3/4] cmake + ctest (both build files must agree) -----------------------
echo "" >&2
echo "== [cmake-ctest] verifying cmake builds and tests pass =="
build_dir="$(mktemp -d /tmp/biped-robot-ci-build.XXXXX)"

if ! cmake --version >/dev/null 2>&1; then
  echo "SKIP: cmake not installed — run 'brew install cmake' (macOS) or 'apt-get install cmake'" >&2
elif ! "$ROOT/firmware/host/cmake" \
    -S "$ROOT/firmware/host" \
    -B "$build_dir" \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON 2>/dev/null; then
  echo "FAIL: CMake configure failed (see above)" >&2
  rc=1
elif ! cmake --build "$build_dir" -j"$(nproc)" >/dev/null 2>&1; then
  echo "FAIL: CI build phase failed (see cmake output above)" >&2  
  rc=1
elif ! ctest --test-dir "$build_dir" --output-on-failure >/dev/null 2>&1; then
  echo "FAIL: CI ctest tests failed (see output above)" >&2
  rc=1
else
  rm -rf "$build_dir"
fi

if [ "$rc" -ne 0 ] && [ -d "$build_dir" ]; then
  rm -rf "$build_dir"
fi

# --- [4/4] esp32 firmware build (idf.py link step) ---------------------------
echo "" >&2  
echo "== [esp32-build] verifying ESP-IDF compiles firmware/main =="
ESP_IDF="$HOME/.espressif/frameworks/esp-idf-v5.4" # or wherever esp-idf is installed

if echo "$PATH" | grep -q "idf.py"; then
  cd "$ROOT/firmware/main" && idf.py fullclean >/dev/null 2>&1 && idf.py build
  if [ $? -ne 0 ]; then
    echo "FAIL: esp32 firmware link failed (see above)" >&2  
    rc=1
  fi
elif [ -d "$ESP_IDF" ] && [ -f "$ESP_IDF/export.sh" ]; then
  cd "$ROOT/firmware/main" && . "$ESP_IDF/export.sh" >/dev/null 2>&1 && idf.py build
  if [ $? -ne 0 ]; then
    echo "FAIL: esp32 firmware link failed (see above)" >&2
    rc=1
  fi  
else
# Can't check without ESP-IDF installed, warn and allow skip with env var
echo "WARN: no ESP_IDF detected — set IDF_PATH or export.sh to gate this." >&2
  if [ "${SKIP_ESP32:-0}" = "0" ]; then
    rc=1
    echo "SKIP_ESP32=1 in env overrides, else push blocked until ESP-IDF v5.4 is installed." >&2
  fi
fi

if [ "$rc" -eq 0 ]; then
  echo "" >&2  
  echo "All gates passed. Safe to push."
  exit 0
else
  echo "" >&2
  echo "Pre-push gate FAILED. Push blocked until fix is pushed." >&2
  # Document escape hatch (git push --no-verify) if you know what you're doing
  echo "" >&2  
  exit 1
fi
