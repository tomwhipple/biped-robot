# Python venv (direnv-activated)
.venv/
__pycache__/
*.pyc

# Local env / secrets
.env

# make: everything generated that git does not track (`make help`, paths.py)
build/

# The old output folders; nothing writes there now and make clean deletes them.
cad/gcode/
cad/v6/gcode/
cad/step/
cad/v6/step/
cad/renders/
cad/v6/renders/
sim/renders/
experiments/plan-b-bench/stl/
experiments/plan-b-bench/_v3_step/
sim/*.gif
sim/*.png

# Rendered movies are never committed (large binaries; regenerate them)
*.mov
*.mp4
*.webm

# Training artifacts (keep the published report page)
sim/runs/*
!sim/runs/night_summary.html
infra/.last_train
infra/runpod/.last_pod

# SIL: the weight blob is regenerable (tools/export_policy_weights.py)
sim/sil/weights/*.silw
sweeps/

# Hardware sessions: tools/obs_capture.py's CSVs, the session logs
captures/
hw_sessions/

# Fetched C++ deps for bimo_gui (make -C firmware/host deps) -- pinned, never
# committed: the repo stays first-party source.
third_party/

# joint-puppet session logs (hand-posing sessions; export what matters)
sim/puppet_sessions/

# macOS
.DS_Store
