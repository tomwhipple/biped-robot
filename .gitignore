# Python venv (direnv-activated)
.venv/
__pycache__/
*.pyc

# Local env / secrets
.env

# Training artifacts (keep the published report page)
sim/runs/*
!sim/runs/night_summary.html

# macOS
.DS_Store

# OpenSCAD/MuJoCo scratch renders written next to scripts
sim/*.gif
sim/*.png

# Rendered movie/animation artifacts (large binaries; regenerate from the
# render scripts instead of committing them)
*.mov
*.mp4
*.webm
**/renders/*.gif
infra/.last_train
infra/runpod/.last_pod
cad/step/*.FCBak
cad/step/poses/

# animate_assembly.py writes and deletes these per run
cad/renders/_anim/

# animate_dressed_rom.py writes and rewrites these per run
cad/renders/_dressed/
# animate_joint_rom.py, same deal
cad/renders/_jointrom/

# SIL: the weight blob is regenerable (tools/export_policy_weights.py)
sim/sil/weights/*.silw
sweeps/

# tools/obs_capture.py writes one CSV per hardware capture
captures/

# cad/slice.py output: projects + gcode are build artifacts, regenerate them
cad/gcode/
hw_sessions/

# Fetched C++ deps for bimo_gui (make -C firmware/host deps) -- pinned, never
# committed: the repo stays first-party source.
third_party/

# joint-puppet session logs (hand-posing sessions; export what matters)
sim/puppet_sessions/
