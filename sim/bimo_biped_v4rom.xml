  <!-- actuators listed in joint-tree (qpos-address) order so the action
       vector, qpos slice and default pose all share one index layout:
       [L_yaw, L_roll, L_pitch, L_knee, L_ankle, R_yaw, R_roll, ...] -->
  <!-- THE POLICY RANGE (v4rom, 2026-08-03).
       ctrlrange on a <position> actuator is the range of joint targets the
       actuator will accept, and it is what sim/walker_env.py and
       sim/mjx/env_mjx.py scale actions against (_policy_range(): ctrlrange
       when the actuator declares one, the joint limit otherwise -- so v2,
       v3yaw and every legacy referee, which declare none, are untouched).

       Every number below is v3yaw's joint range, unchanged, ON PURPOSE. The
       joint limits above are now the MECHANICAL stop (roll to 55 abduction,
       pitch to +90 back); the action map must not follow them, because
       action +-1 is defined as "the edge of the range" and moving the edge
       silently re-scales every action a trained policy emits. Keeping the
       policy range fixed is what lets loco_v12knee_warm's weights mean the
       same joint angles on this plant as on v3yaw -- so a warm start begins
       at the old behaviour and only has to learn the new CONTACTS. Opening
       the extra travel to the policy is a deliberate later commit, and it
       costs a full retrain (precedent: v8foot, v12knee_warm).

       *** UNITS: RADIANS. *** The compiler's angle="degree" converts joint
       ranges and geom angles; it does NOT convert ctrlrange (MuJoCo leaves
       actuator control units alone, since a control is not necessarily an
       angle). These are therefore deg*pi/180, spelled out to 6 decimals, and
       tests/test_rom_contacts.py asserts each one against the degree value it
       is supposed to be. Do not "fix" them to look like the joint ranges. -->
  <actuator>
    <position name="L_hip_yaw"   joint="L_hip_yaw"   ctrlrange="-0.7853981634  0.7853981634"/>  <!-- -45 .. +45 -->
    <position name="L_hip_roll"  joint="L_hip_roll"  ctrlrange="-0.4363323130  0.4363323130"/>  <!-- -25 .. +25 -->
    <position name="L_hip_pitch" joint="L_hip_pitch" ctrlrange="-1.9198621772  1.0471975512"/>  <!-- -110 .. +60 -->
    <position name="L_knee"      joint="L_knee"      ctrlrange="-1.6580627894  0.0872664626"/>  <!-- -95 .. +5 -->
    <position name="L_ankle"     joint="L_ankle"     ctrlrange="-0.6981317008  0.6981317008"/>  <!-- -40 .. +40 -->
    <position name="R_hip_yaw"   joint="R_hip_yaw"   ctrlrange="-0.7853981634  0.7853981634"/>  <!-- -45 .. +45 -->
    <position name="R_hip_roll"  joint="R_hip_roll"  ctrlrange="-0.4363323130  0.4363323130"/>  <!-- -25 .. +25 -->
    <position name="R_hip_pitch" joint="R_hip_pitch" ctrlrange="-1.9198621772  1.0471975512"/>  <!-- -110 .. +60 -->
    <position name="R_knee"      joint="R_knee"      ctrlrange="-1.6580627894  0.0872664626"/>  <!-- -95 .. +5 -->
    <position name="R_ankle"     joint="R_ankle"     ctrlrange="-0.6981317008  0.6981317008"/>  <!-- -40 .. +40 -->
  </actuator>

  <!-- INTER-LEG CONTACT (v4rom). The only self-collision in the model, and it
       is enumerated rather than filtered: the legcol geoms carry contype 0 /
       conaffinity 0, so these four pairs are the complete list of things on
       this robot that can touch each other.
         thigh x thigh   -- crossed-leg poses; onset ~19 deg of adduction, well
                            behind the shank pair, so it never sets the limit
                            in the standing sweep. Present so a raised-thigh
                            cross has something to hit.
         thigh x shank   -- one leg raised, the other down (scissor).
         shank x shank   -- THE measured pair: 9 deg adduction standing,
                            8.5 deg per side on the yaw cross.
       Feet are deliberately absent (see the header). condim/solref are the
       MuJoCo defaults -- the same softness the pads and the floor already use.
       Consequence worth knowing: pressed at full actuator force the capsules
       sink 1-6 mm, so the legs overlap by up to ~2 deg past the onset. The
       measured numbers are LOAD ONSETS (the bench read the load rising, not a
       hard stop), so a compliant contact is the right shape for them. -->
  <contact>
    <pair geom1="L_col_thigh" geom2="R_col_thigh"/>
    <pair geom1="L_col_thigh" geom2="R_col_shank"/>
    <pair geom1="L_col_shank" geom2="R_col_thigh"/>
    <pair geom1="L_col_shank" geom2="R_col_shank"/>
  </contact>

  <sensor>
    <framezaxis objtype="site" objname="imu" name="torso_up"/>
    <framepos   objtype="site" objname="imu" name="torso_pos"/>
  </sensor>
</mujoco>
