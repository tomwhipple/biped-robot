<mujoco model="bimo_like_biped_v2">
  <!-- PROPOSED update matching the realized CAD (cad/parts.py, cad/dimensions.py).
       Differences vs bimo_biped.xml (v1):
         1. Torso center 0.280 -> 0.283 m (ankle axis is 16.9 mm above ground:
            the STS3215 lies on its side in the foot, axis at half its 24.72 mm
            width above the pocket floor; v1 assumed 14 mm).
         2. Foot sole 96 x 52 x 8 mm, center 10 mm ahead of the ankle
            (v1: 84 x 48 x 12 at +12) - matches the printed foot + TPU pad.
         3. Head geom removed: no head is built; electronics tower stays within
            the torso box envelope. Its mass is folded into the torso.
         4. Explicit masses from the CAD mass rollup + measured servo mass
            (55 g each), instead of tuned densities:
              torso 323.5 g (pelvis+tower prints, 2 roll servos, 3S LiPo 78 g,
                           driver board 20 g, wiring/screws)
              hip link 29 g (yoke_roll + yoke_pitch + screws)
              thigh/shin 77 g each (servo + leg_link + screws)
              foot 91 g (servo + foot print + TPU pad + screws)
            Total 0.879 kg (v1: 0.93 kg).
         5. Joint offsets unchanged: hip-roll -36, roll->pitch 50, thigh 90,
            shin 90 (all confirmed buildable with the real servo dimensions).
         6. CAD-true inertia: explicit <inertial> per body, computed from the
            printed-part STL meshes (cad/stl/, PLA rho*0.90) plus servo/battery/
            board boxes at their CAD positions (sim/build_v2_inertia.py; box
            geoms remain for collision/visuals, masses kept as documentation).
       Joint ranges and actuator model unchanged.
       7. CAD meshes (cad/stl/) as geoms: class "cad" parts collide with the
          floor via their convex hulls (contype 2 vs floor conaffinity 3), so
          falls, knee strikes and shin-fork grazes on bumps are physical --
          but NOT with the soles/each other (sole-floor contact is unchanged:
          the flat box exactly matches the real TPU pad; foot mesh is
          visual-only to avoid doubling that contact). Legacy segment boxes
          moved to group 3 (hidden, non-colliding, masses documentation-only:
          real inertia is the explicit <inertial> per body). -->
  <compiler angle="degree" autolimits="true" meshdir="../cad/stl"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="900" offheight="1100"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35"/>
  </visual>

  <default>
    <joint type="hinge" damping="0.6" armature="0.008" frictionloss="0.02" limited="true"/>
    <position kp="40" forcerange="-3 3"/>          <!-- STS3215 ~2.9 N*m stall -->
    <geom contype="0" conaffinity="0"/>            <!-- internal parts don't self-collide -->
    <default class="cad">
      <geom type="mesh" contype="2" conaffinity="0" group="1" rgba="0.82 0.84 0.87 1"/>
    </default>
    <default class="cadvis">
      <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.82 0.84 0.87 1"/>
    </default>
    <default class="servo">
      <geom contype="2" conaffinity="0" group="1" rgba="0.22 0.23 0.27 1"/>
    </default>
  </default>

  <asset>
    <!-- checker floor: the render camera tracks the torso, so an untextured
         plane makes the dash look like running in place -->
    <texture name="grid" type="2d" builtin="checker" rgb1="0.87 0.89 0.92"
             rgb2="0.77 0.80 0.85" width="512" height="512"/>
    <material name="floor_mat" texture="grid" texrepeat="24 24" texuniform="true"/>
    <mesh name="pelvis"     file="pelvis.stl"     scale="0.001 0.001 0.001"/>
    <mesh name="tower"      file="tower.stl"      scale="0.001 0.001 0.001"/>
    <mesh name="gopro_base" file="gopro_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="yoke_roll"  file="yoke_roll.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="yoke_pitch" file="yoke_pitch.stl" scale="0.001 0.001 0.001"/>
    <mesh name="leg_link"   file="leg_link.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="foot"       file="foot.stl"       scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0.6 0.4 1.5" dir="-0.4 -0.3 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.1" contype="1" conaffinity="3"
          material="floor_mat" friction="1 0.02 0.001"/>

    <body name="torso" pos="0 0 0.283">
      <freejoint/>
      <inertial pos="0.0001 0 -0.0005" quat="0.5006 -0.4992 -0.4984 0.5018" mass="0.3235" diaginertia="2.4938e-04 2.7123e-04 4.2450e-04"/>
      <geom name="torso" type="box" size="0.023 0.052 0.036" mass="0.344" rgba="0.80 0.82 0.85 1" group="3"/>
      <geom class="cad" mesh="pelvis" pos="0 0 0.00411"/>
      <geom class="cad" mesh="tower" pos="0 0 0.00411"/>
      <geom class="cad" mesh="gopro_base" pos="0 0 0.04111"/>
      <geom name="servo_L_roll" class="servo" type="box" pos="0 0.028 -0.02346" size="0.01735 0.01236 0.02261"/>
      <geom name="servo_R_roll" class="servo" type="box" pos="0 -0.028 -0.02346" size="0.01735 0.01236 0.02261"/>
      <geom name="battery" type="box" pos="-0.001 0 0.01336" size="0.015 0.0335 0.00925"
            group="1" rgba="0.16 0.30 0.55 1"/>
      <site name="imu" pos="0 0 0"/>

      <!-- ================= LEFT LEG ================= -->
      <body name="L_hip" pos="0 0.028 -0.036">
        <joint name="L_hip_roll" axis="1 0 0" range="-25 25"/>
        <inertial pos="-0.0010 0.0001 -0.0213" quat="-0.4367 0.2117 0.8367 0.2538" mass="0.029" diaginertia="1.0289e-05 1.1641e-05 1.1900e-05"/>
        <geom type="box" pos="0 0 -0.025" size="0.0175 0.0123 0.025" mass="0.029" rgba="0.22 0.23 0.27 1" group="3"/>
        <geom class="cad" mesh="yoke_roll"/>
        <geom class="cad" mesh="yoke_pitch" pos="0 0 -0.05"/>
        <body name="L_thigh" pos="0 0 -0.05">
          <joint name="L_hip_pitch" axis="0 1 0" range="-60 60"/>
        <inertial pos="-0.0010 0.0002 -0.0234" quat="0.7141 -0.0024 -0.7000 0.0056" mass="0.077" diaginertia="1.7646e-05 4.9547e-05 5.8062e-05"/>
          <geom type="box" pos="0 0 -0.045" size="0.0175 0.0123 0.045" mass="0.077" rgba="0.24 0.25 0.29 1" group="3"/>
          <geom class="cad" mesh="leg_link"/>
          <geom class="servo" type="box" pos="0 0 -0.0125" size="0.01236 0.01735 0.02261"/>
          <body name="L_shin" pos="0 0 -0.09">
            <joint name="L_knee" axis="0 1 0" range="-95 5"/>
        <inertial pos="-0.0010 0.0002 -0.0234" quat="0.7141 -0.0024 -0.7000 0.0056" mass="0.077" diaginertia="1.7646e-05 4.9547e-05 5.8062e-05"/>
            <geom type="box" pos="0 0 -0.045" size="0.0175 0.0123 0.045" mass="0.077" rgba="0.24 0.25 0.29 1" group="3"/>
          <geom class="cad" mesh="leg_link"/>
          <geom class="servo" type="box" pos="0 0 -0.0125" size="0.01236 0.01735 0.02261"/>
            <body name="L_foot" pos="0 0 -0.09">
              <joint name="L_ankle" axis="0 1 0" range="-40 40"/>
        <inertial pos="-0.0029 0 -0.0048" quat="0.9971 -0.0001 0.0766 -0.0001" mass="0.091" diaginertia="2.0063e-05 5.9610e-05 6.8819e-05"/>
              <geom name="L_sole" type="box" pos="0.010 0 -0.0129" size="0.048 0.026 0.004"
                    contype="1" conaffinity="1" mass="0.091" rgba="0.20 0.21 0.24 1" friction="1 0.02 0.001"/>
              <geom class="cadvis" mesh="foot" pos="0 0 -0.01636"/>
              <geom class="servo" type="box" pos="-0.0125 0 0" size="0.02261 0.01735 0.01236"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ================= RIGHT LEG ================= -->
      <body name="R_hip" pos="0 -0.028 -0.036">
        <joint name="R_hip_roll" axis="1 0 0" range="-25 25"/>
        <inertial pos="-0.0010 0.0001 -0.0213" quat="-0.4367 0.2117 0.8367 0.2538" mass="0.029" diaginertia="1.0289e-05 1.1641e-05 1.1900e-05"/>
        <geom type="box" pos="0 0 -0.025" size="0.0175 0.0123 0.025" mass="0.029" rgba="0.22 0.23 0.27 1" group="3"/>
        <geom class="cad" mesh="yoke_roll"/>
        <geom class="cad" mesh="yoke_pitch" pos="0 0 -0.05"/>
        <body name="R_thigh" pos="0 0 -0.05">
          <joint name="R_hip_pitch" axis="0 1 0" range="-60 60"/>
        <inertial pos="-0.0010 0.0002 -0.0234" quat="0.7141 -0.0024 -0.7000 0.0056" mass="0.077" diaginertia="1.7646e-05 4.9547e-05 5.8062e-05"/>
          <geom type="box" pos="0 0 -0.045" size="0.0175 0.0123 0.045" mass="0.077" rgba="0.24 0.25 0.29 1" group="3"/>
          <geom class="cad" mesh="leg_link"/>
          <geom class="servo" type="box" pos="0 0 -0.0125" size="0.01236 0.01735 0.02261"/>
          <body name="R_shin" pos="0 0 -0.09">
            <joint name="R_knee" axis="0 1 0" range="-95 5"/>
        <inertial pos="-0.0010 0.0002 -0.0234" quat="0.7141 -0.0024 -0.7000 0.0056" mass="0.077" diaginertia="1.7646e-05 4.9547e-05 5.8062e-05"/>
            <geom type="box" pos="0 0 -0.045" size="0.0175 0.0123 0.045" mass="0.077" rgba="0.24 0.25 0.29 1" group="3"/>
          <geom class="cad" mesh="leg_link"/>
          <geom class="servo" type="box" pos="0 0 -0.0125" size="0.01236 0.01735 0.02261"/>
            <body name="R_foot" pos="0 0 -0.09">
              <joint name="R_ankle" axis="0 1 0" range="-40 40"/>
        <inertial pos="-0.0029 0 -0.0048" quat="0.9971 -0.0001 0.0766 -0.0001" mass="0.091" diaginertia="2.0063e-05 5.9610e-05 6.8819e-05"/>
              <geom name="R_sole" type="box" pos="0.010 0 -0.0129" size="0.048 0.026 0.004"
                    contype="1" conaffinity="1" mass="0.091" rgba="0.20 0.21 0.24 1" friction="1 0.02 0.001"/>
              <geom class="cadvis" mesh="foot" pos="0 0 -0.01636"/>
              <geom class="servo" type="box" pos="-0.0125 0 0" size="0.02261 0.01735 0.01236"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="L_hip_roll"  joint="L_hip_roll"/>
    <position name="L_hip_pitch" joint="L_hip_pitch"/>
    <position name="L_knee"      joint="L_knee"/>
    <position name="L_ankle"     joint="L_ankle"/>
    <position name="R_hip_roll"  joint="R_hip_roll"/>
    <position name="R_hip_pitch" joint="R_hip_pitch"/>
    <position name="R_knee"      joint="R_knee"/>
    <position name="R_ankle"     joint="R_ankle"/>
  </actuator>

  <sensor>
    <framezaxis objtype="site" objname="imu" name="torso_up"/>
    <framepos   objtype="site" objname="imu" name="torso_pos"/>
  </sensor>
</mujoco>
